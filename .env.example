# --- Anthropic ---------------------------------------------------------------
# Server-side only. Nothing here is VITE_-prefixed, so none of it reaches the
# browser bundle.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
#CLAUDE_MODEL=claude-opus-5

# Optional. Iterations of the tool loop, not individual calls -- parallel calls
# in one turn count as one. Defaults to 30.
#ORBIT_MAX_ITERATIONS=30

# --- OrbitAI MCP server ------------------------------------------------------
# Start it from the OrbitAI repo with ./start-server.sh (HTTP mode, POST-only).
#ORBIT_MCP_URL=http://127.0.0.1:3600/mcp

# --- Chat history ------------------------------------------------------------
# This connection stores conversations only. It is NOT what the OrbitAI tools
# operate on -- they reach Atlas with their own credentials, configured in the
# MCP server.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority"

# Optional. Defaults to orbitai.
#ORBIT_DB_NAME=orbitai

# --- Server ------------------------------------------------------------------
#PORT=7002

# Optional. Defaults to logs/orbit.log.
#ORBIT_LOG_FILE=

# --- Browsed clusters (the sidebar tree) -------------------------------------
# The clusters the sidebar tree lists. Read-only: the tree calls listDatabases
# and listCollections and nothing else.
#
# This is a THIRD connection, separate from MONGODB_URI above (chat history)
# and from the Atlas credentials the OrbitAI tools use (configured in the MCP
# server). They may point at the same cluster; they are configured apart so
# they can stop doing so without anything being rewired.
#
# Numbered pairs. NAME is optional and defaults to the host in the URI.
# Add a cluster by adding two more lines with the next number.
ORBIT_CLUSTER_1_NAME=my-cluster
ORBIT_CLUSTER_1_URI="mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority"
#ORBIT_CLUSTER_2_NAME=
#ORBIT_CLUSTER_2_URI=
