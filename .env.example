# --- Anthropic ---------------------------------------------------------------
# Server-side only. Nothing here is VITE_-prefixed, so none of it reaches the
# browser bundle.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
#CLAUDE_MODEL=claude-opus-5

# Optional. Iterations of the tool loop, not individual calls -- parallel calls
# in one turn count as one. Defaults to 30.
#ORBIT_MAX_ITERATIONS=30

# --- OrbitAI MCP server ------------------------------------------------------
# Start it from the OrbitAI repo with ./start-server.sh (HTTP mode, POST-only).
#ORBIT_MCP_URL=http://127.0.0.1:3600/mcp

# --- Chat history ------------------------------------------------------------
# This connection stores conversations only. It is NOT what the OrbitAI tools
# operate on -- they reach Atlas with their own credentials, configured in the
# MCP server.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority"

# Optional. Defaults to orbitai.
#ORBIT_DB_NAME=orbitai

# --- Server ------------------------------------------------------------------
#PORT=4010

# Optional. Defaults to logs/orbit.log.
#ORBIT_LOG_FILE=
